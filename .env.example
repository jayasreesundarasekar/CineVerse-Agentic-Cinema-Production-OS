# ---- Google Gemini ----
GEMINI_API_KEY=

# ---- Google Cloud ----
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=cineverse-artifacts
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
AGENT_ENGINE_ID=

# ---- ClickHouse ----
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cineverse

# ---- Grafana ----
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# ---- Optional research / media APIs ----
PARALLEL_API_KEY=
YOUTUBE_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

# ---- App ----
APP_ENV=development
APP_PORT=8000
MOCK_MODE=true
